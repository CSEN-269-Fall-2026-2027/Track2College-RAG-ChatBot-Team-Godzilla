# Copy to .env at the project root. Never commit .env.
# Required for advisor chat, transcripts, PIQs, and course plans.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
API_PORT=8000

# Required for sign-in and saved student data. Use the public anon/publishable key.
# VITE_* values are visible in the browser. Never use a service-role or secret key here.
VITE_API_URL=http://127.0.0.1:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Backend: checks every request's Supabase session. Reads SUPABASE_URL / SUPABASE_ANON_KEY, falling
# back to the two VITE_ values above.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# Backend-only: store Google OAuth refresh tokens. Never put this in VITE_* or the browser.
# SUPABASE_SERVICE_ROLE_KEY=
# Rollout switch: 1 pauses the UC assistant for everyone (see the rollout notes).
UC_ASSISTANT_PAUSED=0

# Optional: Connect Google (Gmail / Calendar / Drive readonly). App login stays Supabase email.
# Create an OAuth 2.0 Web client in Google Cloud Console; see supabase/README.md (Google connect).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Must match an authorized redirect URI on that client (local default below).
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/google/oauth/callback
# Where the browser returns after connect (frontend origin).
# GOOGLE_FRONTEND_ORIGIN=http://localhost:5500
# Fernet key for encrypting refresh tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# GOOGLE_TOKEN_ENCRYPTION_KEY=

# Optional: voice counselor.
ELEVENLABS_API_KEY=
ELEVENLABS_COUNSELOR_AGENT_ID=

# Optional: cloud application assistant. Local mode uses Playwright Chromium.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
BROWSERBASE_API_URL=https://api.browserbase.com/v1

# Optional: 1 saves student page HTML to backend/uc_debug/. Leave off normally.
UC_DEBUG=0
