# Copy to .env at the project root. Never commit .env.
# Required for advisor chat, transcripts, PIQs, and course plans.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
API_PORT=8000

# Required for sign-in and saved student data. Use the public anon/publishable key.
# VITE_* values are visible in the browser. Never use a service-role or secret key here.
VITE_API_URL=http://127.0.0.1:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: voice counselor.
ELEVENLABS_API_KEY=
ELEVENLABS_COUNSELOR_AGENT_ID=

# Optional: cloud application assistant. Local mode uses Playwright Chromium.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
BROWSERBASE_API_URL=https://api.browserbase.com/v1

# Optional: 1 saves student page HTML to backend/uc_debug/. Leave off normally.
UC_DEBUG=0
