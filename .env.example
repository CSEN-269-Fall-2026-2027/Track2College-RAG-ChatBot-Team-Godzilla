# Track2College: copy to .env at the project root and fill in. .env is gitignored; this file is committed.
# The backend reads .env directly. Vite (frontend) reads it too, but only exposes VITE_* vars to the browser.

# --- Backend (FastAPI) ---
API_PORT=8000

# Groq LLM (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# ElevenLabs voice counselor (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
# Optional: pin a specific agent; otherwise it's found by name or created.
ELEVENLABS_COUNSELOR_AGENT_ID=

# Optional: 1 saves UC page HTML to backend/uc_debug/ for tuning
UC_DEBUG=

# --- Frontend (Vite; VITE_* values ship to the browser, so never put secrets here) ---
VITE_API_URL=http://127.0.0.1:8000
# Supabase → Project Settings → API (see supabase/README.md)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
