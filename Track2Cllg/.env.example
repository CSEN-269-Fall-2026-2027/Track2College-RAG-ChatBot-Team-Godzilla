API_KEY=your_api_key_here
RunPod_API_Key=your_runpod_api_key_here

INFERENCE_PROVIDER=runpod

# Used when INFERENCE_PROVIDER=ollama (local inference, no RunPod needed)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# Used when INFERENCE_PROVIDER=gemini (key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
# Requests per minute; free tier allows 15
GEMINI_RPM=15

RUNPOD_ENDPOINT_ID=your_endpoint_id_here
RUNPOD_ENDPOINT_URL=https://your-runpod-endpoint-url

RUNPOD_PAYLOAD_MODE=vllm

RUNPOD_TIMEOUT_SEC=90
RUNPOD_ASYNC_MAX_WAIT_SEC=300
RUNPOD_POLL_INTERVAL_SEC=2